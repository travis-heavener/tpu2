section .text
_main:
    add SP, 2
    pushw 0
    mov AX, SP
    sub AX, 2
    pushw AX
    pushw -4(SP)
    mov BX, 3
    popw AX
    sadd AX, BX
    mov BX, AX
    popw AX
    sw BX, 0(AX)
    mov AX, SP
    sub AX, 2
    pushw AX
    pushw -4(SP)
    mov BX, 8
    popw AX
    smul BX
    pushw AX
    pop CH
    and DH, 0x80
    or CH, DH
    push CH
    popw BX
    popw AX
    sw BX, 0(AX)
    pushw -2(SP)
    mov BX, 1
    popw AX
    shl AX, BL
    mov DX, AX
    sw DX, -4(SP)
    sub SP, 2
    _mainE:
    popw BX
    mov AX, 3
    syscall
    hlt
section .data
